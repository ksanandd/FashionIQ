# FashionIQ Platform - Master Environment Reference Template
# FashionIQ is a multi-tier architecture consisting of:
# 1. Express Backend (Port 5000) -> Configured in backend/.env
# 2. Next.js Frontend (Port 3000) -> Configured in frontend/.env.local
# 3. Python FastAPI AI Service (Port 8000) -> Configured in ai-service/.env

# ==============================================================================
# 1. EXPRESS BACKEND (backend/.env)
# ==============================================================================
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fashioniq
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace_with_a_secure_random_secret
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration (Password Recovery & Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="FashionIQ <no-reply@fashioniq.com>"

# ==============================================================================
# 2. NEXT.JS FRONTEND (frontend/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ==============================================================================
# 3. FASTAPI AI MICROSERVICE (ai-service/.env)
# ==============================================================================
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fashioniq
AI_SERVICE_SECRET_KEY=replace_with_a_secure_random_secret
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=fashioniq_products
