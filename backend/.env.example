# FashionIQ Express Backend Environment Configuration
# Copy this file to backend/.env and update values for your environment

PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fashioniq
DB_PORT=3306

# Authentication & Security
# Minimum 32-character random string for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# AI Microservice Integration (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace_with_a_secure_random_secret

# CORS Configuration (Allowed origins)
CORS_ORIGIN=http://localhost:3000

# Frontend URL (For password reset links and client redirects)
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration (Password Recovery & Notifications)
# If unconfigured in development, password reset links are logged to console.
# In production, SMTP must be configured with a real transactional mailer (e.g., SendGrid, AWS SES, Mailgun).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="FashionIQ <no-reply@fashioniq.com>"
