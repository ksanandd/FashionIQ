# FashionIQ AI Microservice Environment Configuration (Example)
# Copy to .env and configure for local deployment

ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fashioniq

# Internal Service Shared Secret (Matches backend EXPRESS AI_SERVICE_KEY)
AI_SERVICE_SECRET_KEY=replace_with_a_secure_random_secret

# Model & ChromaDB Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=fashioniq_products
